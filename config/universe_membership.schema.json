{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Point-in-time membership evidence for the configured research universe",
  "description": "Membership intervals for the owner-defined custom research universe; this is not a Nifty 50 constituent schema.",
  "type": "object",
  "required": ["symbol", "valid_from", "valid_to", "source", "source_url", "source_published_at", "evidence_path", "evidence_sha256"],
  "properties": {
    "symbol": {"type": "string", "minLength": 1},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "source_published_at": {"type": "string", "format": "date-time"},
    "evidence_path": {"type": "string", "minLength": 1},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
